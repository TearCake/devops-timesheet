# ========================================================================
# Automated Timesheet Management Platform - Application Properties
# Managed by Ansible Infrastructure-as-Code (Week 13 & 14)
# ========================================================================

server.port={{ app_server_port }}

# Database Configuration
spring.datasource.url={{ db_url }}
spring.datasource.username={{ db_username }}
spring.datasource.password={{ db_password }}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA / Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# Logging
logging.level.com.timesheet=INFO
logging.level.org.springframework.web=WARN
logging.file.name={{ app_log_dir }}/timesheet-application.log
logging.pattern.file=%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n
